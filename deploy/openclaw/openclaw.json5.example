// Lockdown patch for ~/.openclaw/openclaw.json on the agent box (see README.md in this folder).
// Verified against OpenClaw 2026.10.7. Gateway (loopback + token) and the claude-cli runtime come from
// the non-interactive `openclaw onboard` in the README; apply this on top:
//   openclaw config patch --file <this file> --dry-run   then without --dry-run
// Don't run `openclaw doctor --fix` afterwards without re-checking `openclaw config get tools.allow`:
// on 2026.10.7 it drops "browser" and "message" from the allow list.
{
  session: { dmScope: "per-channel-peer" },

  agents: {
    defaults: {
      // Onboarding with --auth-choice anthropic-cli already maps anthropic/* to the claude-cli runtime
      // (the official Claude Code binary, signed in with your own plan). Never use a setup-token here.
      model: { primary: "anthropic/claude-sonnet-5-5" },  // lighter on plan limits than Opus
      skills: ["apply", "check-email", "find-jobs"],      // nothing else is visible to the agent
      heartbeat: { every: "0m" },                         // no unattended wake-ups; schedules are explicit
    },
  },

  skills: {
    // Loaded from <workspace>/skills, where sync-workspace.sh puts immutable copies; no extraDirs,
    // because the agent can't read SKILL.md files outside the workspace.
    load: { extraDirs: [], watch: false },
    allowBundled: [],                                     // no bundled skills; never install from ClawHub
  },

  tools: {
    profile: "full",                                      // with "full", tools.allow is the exact tool list
    allow: ["browser", "exec", "read", "write", "edit", "message"],
    deny: [
      "group:automation",    // cron/automations, gateway, plugins: you manage those from the CLI, not the agent
      "group:web",           // web_search / web_fetch: the browser is enough, fewer ways to leak data
      "group:nodes", "process", "code_execution", "apply_patch", "canvas",
      "sessions_spawn", "sessions_send",
    ],
    fs: { workspaceOnly: true },                          // secrets live outside the workspace
    exec: { mode: "ask" },     // allowlist + ask on miss; askFallback "deny" lives in exec-approvals.example.json
    elevated: { enabled: false },
    agentToAgent: { enabled: false },
    message: { crossContext: { allowWithinProvider: false, allowAcrossProviders: false } },
    web: { search: { enabled: false } },
  },

  browser: {
    enabled: true,
    headless: false,                                      // headed on the Xvfb display (:99) so you can take over over VNC
    defaultProfile: "openclaw",                           // the agent's own profile; never "user"
    executablePath: "/usr/bin/google-chrome-stable",
    evaluateEnabled: false,                               // no arbitrary page JavaScript from the model
    // ssrfPolicy: leave the defaults (private network blocked)
  },
  // Chat channel: discord.patch.json5.example, applied once the bot token is saved.
}
